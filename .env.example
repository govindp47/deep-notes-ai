# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: NVIDIA NIM (only needed when using NVIDIA models) ───────────────
# NVIDIA_API_KEY=nvapi-...

# ── Multi-Part Processing ─────────────────────────────────────────────────────
# TRANSCRIPT_MAX_TOKENS_PER_PART=50000

# ── LLM Model Configuration ───────────────────────────────────────────────────
# TRANSCRIPT_CLEANING_MODEL_PROVIDER=openai
# TRANSCRIPT_CLEANING_MODEL_NAME=gpt-4o-mini
# TRANSCRIPT_CLEANING_MODEL_TEMPERATURE=0.0
# TRANSCRIPT_CLEANING_CHUNK_TOKENS=6000
# TRANSCRIPT_CLEANING_CHUNK_OVERLAP_CHARS=500

# ARTICLE_CLEANING_MODEL_PROVIDER=openai
# ARTICLE_CLEANING_MODEL_NAME=gpt-5-mini
# ARTICLE_CLEANING_MODEL_TEMPERATURE=0.0
# ARTICLE_CLEANING_CHUNK_TOKENS=12000
# ARTICLE_CLEANING_CHUNK_OVERLAP_CHARS=500

# HIERARCHY_MODEL_PROVIDER=openai
# HIERARCHY_MODEL_NAME=gpt-4o-mini
# HIERARCHY_MODEL_TEMPERATURE=0.0
# HIERARCHY_INPUT_TOKENS=18000

# CONTENT_MODEL_PROVIDER=openai
# CONTENT_MODEL_NAME=gpt-4o-mini
# CONTENT_MODEL_TEMPERATURE=0.0
# CONTENT_INPUT_TOKENS=8000
# CONTENT_INPUT_TOKENS_FALLBACK=6000

# SUMMARY_MODEL_PROVIDER=openai
# SUMMARY_MODEL_NAME=gpt-4o-mini
# SUMMARY_MODEL_TEMPERATURE=0.0
# SUMMARY_INPUT_TOKENS=5000
# SUMMARY_INPUT_TOKENS_FALLBACK=4000

# ── Retry Configuration ───────────────────────────────────────────────────────
# MAX_RETRIES=1

# ── Article Ingestion ────────────────────────────────────────────────────
# ARTICLE_REQUEST_TIMEOUT=10
# ARTICLE_MAX_REDIRECTS=5
# ARTICLE_FOLLOW_REDIRECTS=true
# ARTICLE_VERIFY_SSL=true
# ARTICLE_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36

# ── Path Configuration ────────────────────────────────────────────────────────
# OUTPUT_BASE_DIR=output
# ARTEFACTS_DIR=artefacts
# PROMPTS_DIR=deep_notes_ai/domain/prompts
# LOGS_DIR=logs
# CHECKPOINTS_DB=artefacts/checkpoints.db

# ── Feature Flags ─────────────────────────────────────────────────────────────
# USE_SQLITE_CHECKPOINTER=true
# ENABLE_STRUCTURED_LOGGING=true
# LOG_LEVEL=INFO
# ENABLE_LLM_MONITORING=true
